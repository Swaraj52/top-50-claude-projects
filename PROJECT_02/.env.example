# Copy to PROJECT_02/.env and adjust. Never commit the real .env.

# SQLite by default (data/library.db). Any SQLAlchemy URL works, but full-text search uses
# SQLite FTS5, so other databases need the indexer and search ported.
# DATABASE_URL=sqlite:///C:/path/to/PROJECT_02/data/library.db

# Set to true when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
SESSION_DAYS=14

# Optional: Claude writes summaries and answers questions. Without it, summaries are
# extractive and Ask shows the most relevant passages. Each Summarize / Ask is one API call.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Saving links
FETCH_TIMEOUT=15
FETCH_MAX_BYTES=8388608
# Never enable on a shared server: allows fetching private/local network addresses.
ALLOW_PRIVATE_FETCH=false

LOG_LEVEL=INFO
