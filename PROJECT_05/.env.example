# Copy to PROJECT_05/.env. Every value is optional; the app runs without a key.
DATABASE_URL=sqlite:///C:/Users/you/TOP-50-CLAUDE-PROJECTS/PROJECT_05/data/cadence.db
COOKIE_SECURE=false
SESSION_DAYS=30

# Optional: enables Claude-written habit suggestions. Without it the local coach is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=30

RUN_MIGRATIONS=true
LOG_LEVEL=INFO
