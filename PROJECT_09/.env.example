# Copy to PROJECT_09/.env. Every value is optional; the app runs without any key.
DATABASE_URL=sqlite:///C:/Users/you/TOP-50-CLAUDE-PROJECTS/PROJECT_09/data/keystone.db
COOKIE_SECURE=false
SESSION_DAYS=30

# Optional: lets Claude rewrite the local strategy memo from the same stored facts.
# Without it the labelled local memo is the only memo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=30

RUN_MIGRATIONS=true
LOG_LEVEL=INFO
