# Copy to PROJECT_01/.env and adjust. Never commit the real .env.

# SQLite file by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://...)
# DATABASE_URL=sqlite:///C:/path/to/PROJECT_01/data/dashboard.db

# Encrypts stored IMAP passwords and private calendar URLs. Set a long random value
# (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))").
# If empty, one is generated on first run and kept in data/secret.key.
# Changing it makes previously stored credentials unreadable (reconnect them).
APP_SECRET_KEY=

# Set to true when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
SESSION_DAYS=14

# Optional: lets Claude write the daily briefing. Without it the rule-based summary is used.
# Each briefing is one Messages API call (usage is billed to this key).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

LOG_LEVEL=INFO
