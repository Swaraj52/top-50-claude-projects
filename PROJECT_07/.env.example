# Copy to PROJECT_07/.env. Every value is optional; the app runs without any key.
DATABASE_URL=sqlite:///C:/Users/you/TOP-50-CLAUDE-PROJECTS/PROJECT_07/data/switchboard.db
COOKIE_SECURE=false
SESSION_DAYS=30

# Optional: enables Claude-written thread summaries and reply drafts.
# Without it the labelled local writer runs in-process.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=30

RUN_MIGRATIONS=true
LOG_LEVEL=INFO
