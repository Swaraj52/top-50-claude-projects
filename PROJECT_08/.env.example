# Copy to PROJECT_08/.env. Every value is optional; the app runs without any key.
DATABASE_URL=sqlite:///C:/Users/you/TOP-50-CLAUDE-PROJECTS/PROJECT_08/data/loom.db
COOKIE_SECURE=false
SESSION_DAYS=30

# Optional: lets Claude rewrite an answer from the passages local search selected.
# Without it the labelled local extractive answer is the only answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=30

RUN_MIGRATIONS=true
LOG_LEVEL=INFO
