# Copy to PROJECT_03/.env and adjust. Never commit the real .env.

# SQLite by default (data/shutdown.db). Any SQLAlchemy URL should work.
# DATABASE_URL=sqlite:///C:/path/to/PROJECT_03/data/shutdown.db

# Set to true when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
SESSION_DAYS=30

# Optional: Claude writes the end-of-day review. Without a key the review is rule-based.
# Each generated review is one API call.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

LOG_LEVEL=INFO
