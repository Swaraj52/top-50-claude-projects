# Environment variables for Customer Feedback Analyzer (Project 11)

# Debug mode: 1 = enabled, 0 = disabled
DEBUG=0

# Database URL: SQLite for development, PostgreSQL for production
DATABASE_URL=sqlite:///data/foundry.db

# Secret key for session signing (change in production!)
SECRET_KEY=foundry-dev-key-change-in-production

# Whether Claude AI features are enabled
AI_ENABLED=false

# Claude model name when AI is enabled
ANTHROPIC_MODEL=claude-3-opus-20240229

# Python logging level
LOG_LEVEL=INFO

# Session duration in days
SESSION_DAYS=30