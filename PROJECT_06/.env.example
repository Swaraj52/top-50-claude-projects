# Copy to PROJECT_06/.env. Every value is optional; the app runs without a key.
DATABASE_URL=sqlite:///C:/Users/you/TOP-50-CLAUDE-PROJECTS/PROJECT_06/data/quorum.db
COOKIE_SECURE=false
SESSION_DAYS=30

# Optional: enables Claude-written summaries, decisions and follow-ups.
# Without it the local, rule-based extractor is used and labelled "Local extractor".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=30

RUN_MIGRATIONS=true
LOG_LEVEL=INFO
